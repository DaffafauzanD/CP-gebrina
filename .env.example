APP_NAME="CV GEBRINA JAYA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Situs ini tidak memakai database. Seluruh konten (layanan, galeri,
# testimoni) dibaca dari config/content.php.

SESSION_DRIVER=file
SESSION_LIFETIME=120

QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="info@gebrinajaya.com"
MAIL_FROM_NAME="CV GEBRINA JAYA"

# Google tag untuk Google Ads. Biarkan kosong di lokal supaya kunjungan saat
# development tidak tercatat. Nilai produksi ada di .env.production.example.
GOOGLE_TAG_ID=
GOOGLE_ADS_CONVERSION_WHATSAPP=
GOOGLE_ADS_CONVERSION_PHONE=
GOOGLE_TAG_MANAGER_ID=

VITE_APP_NAME="${APP_NAME}"
