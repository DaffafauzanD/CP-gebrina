# Template environment produksi untuk https://www.cvgebrinajaya.com
#
# Cara pakai di shared hosting:
#   1. Salin berkas ini menjadi .env (di root aplikasi, BUKAN di public_html)
#   2. Isi APP_KEY dengan hasil `php artisan key:generate --show` dari komputermu
#   3. Selesai. Tidak ada database yang perlu dibuat.

APP_NAME="CV GEBRINA JAYA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://www.cvgebrinajaya.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Situs ini tidak memakai database. Seluruh konten (layanan, galeri, testimoni)
# dibaca dari config/content.php, jadi tidak ada DB_* yang perlu diisi.

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=sync
CACHE_STORE=file

# Tidak ada fitur yang mengirim email (form kontak sudah dihapus, konversi
# seluruhnya lewat WhatsApp).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@cvgebrinajaya.com"
MAIL_FROM_NAME="CV GEBRINA JAYA"

# Google tag untuk Google Ads. Ambil dari Google Ads > Tools > Data manager >
# Google tag, formatnya "AW-XXXXXXXXXX".
GOOGLE_TAG_ID="AW-18449063403"

# Conversion action Google Ads, nilai "send_to" dari event snippet
# (format "AW-18449063403/label"). Klik link WhatsApp dan telepon di seluruh
# halaman otomatis terhitung. Biarkan kosong untuk yang tidak dilacak.
GOOGLE_ADS_CONVERSION_WHATSAPP="AW-18449063403/1ESzCNWhqfgcEOu7md1E"
GOOGLE_ADS_CONVERSION_PHONE="AW-18449063403/DO2ZCNihqfgcEOu7md1E"

# Container Google Tag Manager dari tagmanager.google.com, formatnya
# "GTM-XXXXXXX". Jangan pasang ulang tag Google Ads + konversi WA/telepon di
# dalam container ini: keduanya sudah dikirim oleh GOOGLE_TAG_ID di atas,
# jadi konversi akan terhitung dua kali.
GOOGLE_TAG_MANAGER_ID="GTM-WP9TTGV7"

VITE_APP_NAME="${APP_NAME}"
